# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored and never committed — .env.example just documents
# what variables the app expects.

# Supabase — the app's real database (Postgres) and product photo storage.
# Get these from your Supabase project: Settings -> API. Run
# supabase/schema.sql against that project before starting the app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — used for AI request classification. Get a key from
# https://ai.google.dev ("Get API key"). Server-side only.
GEMINI_API_KEY=

# Termii — sends the phone verification (OTP) SMS shown at signup and on
# "Forgot password?". Optional: leave TERMII_API_KEY blank and both flows
# work exactly as before, with no phone verification step. Get a key from
# https://termii.com (Settings -> API Key) after signing up. This key is
# used ONLY on the server (lib/sms.ts) — it is never sent to the browser,
# a mobile app, or committed to the repo.
# TERMII_BASE_URL defaults to https://v4.api.termii.com if left blank —
# only set it if Termii's dashboard tells you to use a different one.
# TERMII_SENDER_ID is optional too — leave it blank to use Termii's shared
# default sender while you wait for a custom Sender ID to be approved.
TERMII_API_KEY=
TERMII_BASE_URL=
TERMII_SENDER_ID=

# OTP behavior — all optional, these are the defaults if left blank.
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_RESENDS=3
