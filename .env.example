# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored and never committed — .env.example just documents
# what variables the app expects.

# Supabase — the app's real database (Postgres) and product photo storage.
# Get these from your Supabase project: Settings -> API. Run
# supabase/schema.sql against that project before starting the app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — used for AI request classification. Get a key from
# https://ai.google.dev ("Get API key"). Server-side only.
GEMINI_API_KEY=

# Termii — sends the phone verification (OTP) SMS shown at signup and on
# "Forgot password?". Optional: leave TERMII_API_KEY blank and both flows
# work exactly as before, with no phone verification step. Get a key from
# https://termii.com (Settings -> API Key) after signing up. This key is
# used ONLY on the server (lib/sms.ts) — it is never sent to the browser,
# a mobile app, or committed to the repo.
# TERMII_BASE_URL defaults to https://v4.api.termii.com if left blank —
# only set it if Termii's dashboard tells you to use a different one.
# TERMII_SENDER_ID is optional too — leave it blank to use Termii's shared
# default sender while you wait for a custom Sender ID to be approved.
TERMII_API_KEY=
TERMII_BASE_URL=
TERMII_SENDER_ID=

# OTP behavior — all optional, these are the defaults if left blank.
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_RESENDS=3

# Paystack — powers Store/FindIt Pro subscription checkout (lib/paystack.ts).
# Optional: leave PAYSTACK_SECRET_KEY blank and the app still works — Free
# and trial-eligible plan changes apply immediately with no payment, and a
# plan that genuinely requires payment reports "not configured" instead of
# pretending to charge anyone. An admin can still activate a paid plan
# manually via POST /api/admin/subscriptions/grant in the meantime. Get keys
# from https://dashboard.paystack.com (Settings -> API Keys & Webhooks) —
# use the TEST secret key while developing. Also add your deployed
# domain + /api/payments/paystack/webhook as a webhook URL there once you
# have one, so successful charges actually activate the subscription.
PAYSTACK_SECRET_KEY=

# How long a staff sign-in lasts, in minutes (optional, defaults to 60).
# Reaching the Admin Queue takes a second password entry on the staff screen
# even for an account that's already logged in as an admin — a session lasts
# 30 days, and an admin capability shouldn't. The unlock is stored on the
# session row (migration 020), slides forward while an admin is working, and
# is cleared by logging out or by "Leave admin". Lower this for a shared
# device; raise it if your admins find re-entry disruptive.
ADMIN_UNLOCK_MINUTES=60
