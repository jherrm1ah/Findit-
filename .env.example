# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored and never committed — .env.example just documents
# what variables the app expects.

# Supabase — the app's real database (Postgres) and product photo storage.
# Get these from your Supabase project: Settings -> API. Run
# supabase/schema.sql against that project before starting the app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — used for AI request classification. Get a key from
# https://ai.google.dev ("Get API key"). Server-side only.
GEMINI_API_KEY=

# Termii — sends the phone verification (OTP) code shown during signup.
# Optional: leave blank and signup works exactly as before, with no phone
# verification step. Get a key from https://termii.com (Settings -> API Key)
# after signing up. TERMII_SENDER_ID is optional too — leave it blank to use
# Termii's shared default sender while you wait for a custom Sender ID to be
# approved.
TERMII_API_KEY=
TERMII_SENDER_ID=
