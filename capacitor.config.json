{
  "appId": "com.shopwithfindit.app",
  "appName": "FindIt",
  "webDir": "android-shell",
  "server": {
    "url": "https://www.shopwithfindit.com",
    "androidScheme": "https",
    "errorPath": "offline.html",
    "allowNavigation": [
      "shopwithfindit.com",
      "*.shopwithfindit.com",
      "findit-zeta-three.vercel.app",
      "paystack.com",
      "*.paystack.com",
      "paystack.co",
      "*.paystack.co"
    ]
  },
  "android": {
    "backgroundColor": "#FFFFFF",
    "allowMixedContent": false,
    "appendUserAgent": "FindItAndroid"
  }
}
